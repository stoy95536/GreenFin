# GreenFin Demo Environment Example

APP_ENV=development
APP_NAME=GreenFin
APP_TIMEZONE=Asia/Taipei

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Storage
# Demo persistence is JSON files under backend/data/ (see docs/DECISIONS.md ADR-0006).
# There is intentionally no DATABASE_URL.

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api

# Rules
RULE_VERSION=GREENFIN_DEMO_V1

# Demo only
DEMO_MODE=true
